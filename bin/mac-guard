#!/bin/bash
# mac-guard launcher.
#   mac-guard            open the dashboard in the browser
#   mac-guard run        run an audit now and print the result
#   mac-guard status     one-line summary of the last audit
#   mac-guard repo URL   clone, scan and open an untrusted repo in a container (see untrusted/open-repo.sh)
set -euo pipefail
SELF="$0"; while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
PY=/usr/bin/python3
export PYTHONPATH="$REPO/server" PYTHONDONTWRITEBYTECODE=1
conf() { "$PY" -c "import config; print(config.$1)"; }

case "${1:-open}" in
  open)
    HOST=$(conf HOST); PORT=$(conf PORT)
    # 127.0.0.1 is shared by every account on this Mac: never hand a sign-in link to someone else's listener
    owner=$(lsof -nP -a -iTCP@"$HOST":"$PORT" -sTCP:LISTEN -Fu 2>/dev/null | sed -n 's/^u//p' | head -1)
    if [ -n "$owner" ] && [ "$owner" != "$(id -u)" ]; then
      echo "refusing: port $PORT is held by uid $owner, not by you" >&2; exit 1
    fi
    if ! launchctl print "gui/$(id -u)/com.abdulhadi.mac-guard.dashboard" >/dev/null 2>&1 && [ -z "$owner" ]; then
      echo "the dashboard job is not loaded - run: $REPO/install.sh" >&2; exit 1
    fi
    # a single-use, 60-second sign-in value; the page trades it for the real token
    NONCE=$("$PY" -c "import server; server.load_token(); print(server.create_nonce())")
    open "http://$HOST:$PORT/#n=$NONCE"
    ;;
  run)
    exec "$PY" "$REPO/server/runner.py" --trigger manual
    ;;
  repo)
    shift
    exec "$REPO/untrusted/open-repo.sh" "$@"
    ;;
  status)
    "$PY" - <<'PY'
import db
db.init()
s = db.state()
run = s["last_run"]
if not run:
    print("no audit has completed yet - run: mac-guard run")
else:
    n = lambda sev: sum(f["severity"] == sev for f in s["open"])
    print(f"last audit {run['finished_at']}: open high {n('high')}, medium {n('medium')}, low {n('low')}; "
          f"accepted {len(s['accepted'])}; checks passed {run['n_pass']}")
PY
    ;;
  *)
    sed -n '2,6p' "$SELF" | sed 's/^# \{0,1\}//'
    ;;
esac
